# Content Studio · קובץ המפתחות. העתק לקובץ בשם .env באותה תיקייה ומלא את הערכים.
# הקובץ .env לא נכנס ל-Git ולא נשלח לדפדפן. אם FAL_KEY חסר כאן, המנוע מחפש אותו ב-C:\dev\.env.local.

# fal.ai · fal.ai/dashboard/keys · פורמט key_id:key_secret · משמש לשני מנועי התמונות
FAL_KEY=

# Anthropic · console.anthropic.com · כתיבת פוסטים, מחקר, זיהוי תמונות רפרנס, בניית פרומפטים · אפשר להשאיר ריק: המנוע קורא מ-C:\dev\.env.local
ANTHROPIC_API_KEY=

# אופציונלי: מודל אחר (ברירת מחדל claude-opus-5-5)
# ANTHROPIC_MODEL=claude-opus-5-5

# Higgsfield API · console.higgsfield.ai · להנפשת הסטילים בשלב הוידאו לטיקטוק (בלי זה: זום על הסטילים)
HIGGSFIELD_KEY_ID=
HIGGSFIELD_KEY_SECRET=
